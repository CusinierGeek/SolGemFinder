{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "SolGemFinder.IndexerWorker.Services.BitQueryPumpFunService": "Information"
    }
  },
  "BitQuery": {
    "ApiEndpoint": "https://streaming.bitquery.io/eap",
    "OAuthToken": "",
    "QueryWindowMinutes": 5,
    "MinBondingProgressPercent": 95,
    "MaxTokensPerQuery": 100,
    "RequestTimeoutSeconds": 30,
    "MaxRetryAttempts": 3,
    "RetryDelayMilliseconds": 1000
  },
  "IndexerService": {
    "PollingIntervalMs": 30000,
    "DiscoveryStrategy": "AboutToGraduate"
  }
}
