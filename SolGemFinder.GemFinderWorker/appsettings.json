{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "SolGemFinder.ScoringWorker": "Debug",
      "SolGemFinder.ScoringWorker.Services.RedisCacheService": "Debug",
      "SolGemFinder.ScoringWorker.Services.OnChainValidator": "Debug"
    }
  },
  "ConnectionStrings": {
    "redis": "localhost:6379"
  },
  "BitQuery": {
    "ApiEndpoint": "https://streaming.bitquery.io/eap",
    "OAuthToken": "",
    "QueryWindowMinutes": 5,
    "MinBondingProgressPercent": 80,
    "MaxTokensPerQuery": 100,
    "RequestTimeoutSeconds": 30,
    "MaxRetryAttempts": 3,
    "RetryDelayMilliseconds": 1000
  },
  "Solana": {
    "RpcUrl": ""
  },
  "TokenCache": {
    "WatchlistTtlHours": 24,
    "StateTtlMinutes": 5,
    "BlacklistTtlDays": 7,
    "ScoreTtlMinutes": 10
  },
  "Scoring": {
    "WatchlistPollingIntervalSeconds": 30,
    "TokenGracePeriodSeconds": 300,
    "MaxValidationRetries": 30,
    "MinimumScoreForTrading": 55,
    "MaxWatchlistSize": 1000
  },
  "Liquidity": {
    "MinimumLiquiditySol": 2,
    "MinimumVolume24hSol": 0,
    "UseBitQuery": true
  },
  "PumpFun": {
    "UseBitQuery": true
  },
  "OnChainValidator": {
    "UseBitQuery": true
  },
  "ServiceBus": {
    "Topic": "discoveries",
    "GemFinderSubscription": "gemfinder-sub",
    "TradingTopic": "trading-signals"
  }
}
